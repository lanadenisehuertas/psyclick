{
  "name": "psyclick",
  "version": "1.0.0",
  "description": "PsyClick — Clinical Decision Support System",
  "main": "electron/main.js",
  "scripts": {
    "dev":          "vite",
    "build":        "vite build",
    "preview":      "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "start":        "concurrently -k \"python ../api_server.py\" \"vite\" \"wait-on tcp:5173 tcp:5001 && cross-env NODE_ENV=development electron .\"",
    "dist":         "npm run build && electron-builder --config.directories.output=dist-electron-release",
    "dist:portable":"npm run build && electron-builder --win portable --config.directories.output=dist-electron-release",
    "dist:installer":"npm run build && electron-builder --win nsis --config.directories.output=dist-electron-release"
  },
  "dependencies": {
    "react":            "^18.2.0",
    "react-dom":        "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts":         "^2.12.0",
    "lucide-react":     "^0.378.0",
    "date-fns":         "^3.6.0",
    "clsx":             "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite":                 "^5.2.0",
    "tailwindcss":          "^3.4.3",
    "postcss":              "^8.4.38",
    "autoprefixer":         "^10.4.19",
    "electron":             "^30.0.0",
    "electron-builder":     "^24.13.0",
    "concurrently":         "^8.2.2",
    "cross-env":            "^7.0.3",
    "wait-on":              "^7.2.0"
  },
  "build": {
    "appId":       "com.psyclick.app",
    "productName": "PsyClick",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "!dist/downloads/**/*", "electron/**/*"],
    "win": {
      "target": ["portable", "nsis"],
      "icon":   "../images/LOGOggg.png"
    },
    "nsis": {
      "oneClick":         false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup.${ext}"
    },
    "asar": true,
    "extraResources": [
      { "from": "../config.json",               "to": "." },
      { "from": "../normative_baseline.json",   "to": "." },
      { "from": "../dist-python/psyclick_api", "to": "psyclick_api" },
      { "from": "../images",                   "to": "images" }
    ]
  }
}
